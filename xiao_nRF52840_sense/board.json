{
  "name": "XIAO nRF52840 Sense",
  "version": "1.0.0",
  "description": "Seeed Studio XIAO nRF52840 Sense，使用专用引脚和 USB CDC 配置，支持原厂 Adafruit BLE bootloader 串口 DFU 上传。",
  "compilerTool": "aily-builder",
  "core": "n-able-Arduino:arm-ble",
  "type": "n-able-Arduino:arm-ble:seeed52840sense",
  "mode": ["arduino"],
  "compilerParam": "compile --verbose -b n-able-Arduino:arm-ble:seeed52840sense",
  "linkUploadParam": "probe-rs download --chip nRF52840_xxAA --verify ${'*.elf'};probe-rs reset --chip nRF52840_xxAA",
  "analogPins": [
    ["A0(D0)", "0"],
    ["A1(D1)", "1"],
    ["A2(D2)", "2"],
    ["A3(D3)", "3"],
    ["A4(D4)", "4"],
    ["A5(D5)", "5"]
  ],
  "digitalPins": [
    ["D0", "0"],
    ["D1", "1"],
    ["D2", "2"],
    ["D3", "3"],
    ["D4", "4"],
    ["D5", "5"],
    ["D6", "6"],
    ["D7", "7"],
    ["D8", "8"],
    ["D9", "9"],
    ["D10", "10"]
  ],
  "pwmPins": [
    ["D0", "0"],
    ["D1", "1"],
    ["D2", "2"],
    ["D3", "3"],
    ["D4", "4"],
    ["D5", "5"],
    ["D6", "6"],
    ["D7", "7"],
    ["D8", "8"],
    ["D9", "9"],
    ["D10", "10"]
  ],
  "servoPins": [
    ["D0", "0"],
    ["D1", "1"],
    ["D2", "2"],
    ["D3", "3"],
    ["D4", "4"],
    ["D5", "5"],
    ["D6", "6"],
    ["D7", "7"],
    ["D8", "8"],
    ["D9", "9"],
    ["D10", "10"]
  ],
  "serialPort": [
    ["Serial", "Serial"],
    ["Serial1", "Serial1"]
  ],
  "serialSpeed": [
    ["1200", "1200"],
    ["9600", "9600"],
    ["14400", "14400"],
    ["19200", "19200"],
    ["38400", "38400"],
    ["57600", "57600"],
    ["115200", "115200"],
    ["230400", "230400"],
    ["460800", "460800"],
    ["921600", "921600"]
  ],
  "spi": [["SPI", "SPI"]],
  "spiPins": {
    "SPI": [
      ["MOSI", "10"],
      ["MISO", "9"],
      ["SCK", "8"],
      ["SS", "7"]
    ]
  },
  "spiClockDivide": [
    ["2 (8MHz)", "SPI_CLOCK_DIV2"],
    ["4 (4MHz)", "SPI_CLOCK_DIV4"],
    ["8 (2MHz)", "SPI_CLOCK_DIV8"],
    ["16 (1MHz)", "SPI_CLOCK_DIV16"],
    ["32 (500KHz)", "SPI_CLOCK_DIV32"]
  ],
  "i2c": [["I2C", "Wire"]],
  "i2cPins": {
    "Wire": [
      ["SDA", "4"],
      ["SCL", "5"]
    ]
  },
  "i2cSpeed": [
    ["100kHz", "100000L"],
    ["250kHz", "250000L"],
    ["400kHz", "400000L"]
  ],
  "builtinLed": [
    ["LED_RED", "11"],
    ["LED_GREEN", "13"],
    ["LED_BLUE", "12"]
  ],
  "interruptPins": [
    ["D0", "0"],
    ["D1", "1"],
    ["D2", "2"],
    ["D3", "3"],
    ["D4", "4"],
    ["D5", "5"],
    ["D6", "6"],
    ["D7", "7"],
    ["D8", "8"],
    ["D9", "9"],
    ["D10", "10"]
  ],
  "interruptMode": [
    ["RISING", "RISING"],
    ["FALLING", "FALLING"],
    ["CHANGE", "CHANGE"]
