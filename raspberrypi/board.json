{
  "name": "Raspberry Pi",
  "version": "1.0.0",
  "description": "Raspberry Pi Linux Python board over SSH",
  "core": "linux:python",
  "type": "linux:python:raspberrypi",
  "mode": ["python"],
  "runtime": {
    "kind": "python",
    "adapter": "linux-ssh",
    "entry": "main.py",
    "execution": {
      "transport": "ssh",
      "output": "pty-combined",
      "input": "pty",
      "stop": "process-group",
      "files": "sftp",
      "temporaryRun": true
    },
    "deployment": {
      "autostart": {
        "kind": "systemd",
        "unitDirectory": "/etc/systemd/system"
      }
    }
  },
  "capabilities": {
    "camera": true,
    "display": false,
    "touch": false,
    "audioInput": true,
    "audioOutput": true,
    "imu": false,
    "wifi": true,
    "bluetooth": true,
    "gpio": true,
    "pwm": true,
    "uart": true,
    "i2c": true,
    "spi": true
  },
  "analogPins": [],
  "digitalPins": [
    ["GPIO2 (SDA1)", "2"],
    ["GPIO3 (SCL1)", "3"],
    ["GPIO4", "4"],
    ["GPIO5", "5"],
    ["GPIO6", "6"],
    ["GPIO7 (CE1)", "7"],
    ["GPIO8 (CE0)", "8"],
    ["GPIO9 (MISO)", "9"],
    ["GPIO10 (MOSI)", "10"],
    ["GPIO11 (SCLK)", "11"],
    ["GPIO12 (PWM0)", "12"],
    ["GPIO13 (PWM1)", "13"],
    ["GPIO14 (TXD)", "14"],
    ["GPIO15 (RXD)", "15"],
    ["GPIO16", "16"],
    ["GPIO17", "17"],
    ["GPIO18 (PWM0)", "18"],
    ["GPIO19", "19"],
    ["GPIO20", "20"],
    ["GPIO21", "21"],
    ["GPIO22", "22"],
    ["GPIO23", "23"],
    ["GPIO24", "24"],
    ["GPIO25", "25"],
    ["GPIO26", "26"],
    ["GPIO27", "27"]
  ],
  "pwmPins": [
    ["PWM0 (GPIO12)", "12"],
    ["PWM0 (GPIO18)", "18"],
    ["PWM1 (GPIO13)", "13"]
  ],
  "serialPort": [
    ["serial0", "/dev/serial0"]
  ],
  "serialPins": {
    "/dev/serial0": [
      ["TX", "14"],
      ["RX", "15"]
    ]
  },
  "serialSpeed": [
    ["9600", "9600"],
    ["19200", "19200"],
    ["38400", "38400"],
    ["57600", "57600"],
    ["115200", "115200"]
  ],
  "i2c": [
    ["I2C1", "I2C1"]
  ],
  "i2cPins": {
    "I2C1": [
      ["SDA", "2"],
      ["SCL", "3"]
    ]
  },
  "spi": [
    ["SPI0", "SPI0"]
  ],
  "spiPins": {
    "SPI0": [
      ["CE0", "8"],
      ["CE1", "7"],
      ["SCLK", "11"],
      ["MOSI", "10"],
      ["MISO", "9"]
    ]
  },
  "builtinLed": [
    ["GPIO17", "17"]
  ],
  "cameraConfig": {
    "interface": "v4l2",
    "supportedModels": ["rpicam", "usb-uvc"],
    "device": "/dev/video0",
    "pins": {}
  },
  "specialPins": {
    "led": "17",
    "camera": "/dev/video0",
    "uart": "/dev/serial0"
  }
}
