{
  "name": "CyberCAM",
  "version": "1.1.0",
  "description": "01Studio CyberCAM K230 Python AI camera",
  "core": "python:k230",
  "type": "python:k230:cybercam",
  "mode": [
    "python"
  ],
  "runtime": {
    "kind": "python",
    "adapter": "canmv-k230",
    "entry": "main.py",
    "execution": {
      "transport": "canmv-usbdbg",
      "output": "event-stream",
      "input": "repl",
      "stop": "device-interrupt",
      "files": "canmv-io",
      "temporaryRun": true
    },
    "deployment": {
      "autostart": {
        "kind": "boot-start-sh",
        "directory": "/boot/start",
        "backgroundRequired": true
      }
    }
  },
  "capabilities": {
    "camera": true,
    "display": true,
    "touch": true,
    "audioInput": true,
    "audioOutput": true,
    "imu": true,
    "wifi": true,
    "bluetooth": true,
    "gpio": true,
    "pwm": true,
    "uart": true,
    "i2c": true,
    "spi": true
  },
  "usbVid": "1209",
  "usbPid": "abd1",
  "analogPins": [],
  "digitalPins": [
    [
      "GPIO11 (UART2 TX / I2C2 SCL)",
      "11"
    ],
    [
      "GPIO12 (UART2 RX / I2C2 SDA)",
      "12"
    ],
    [
      "GPIO14 (SPI0 CS0)",
      "14"
    ],
    [
      "GPIO15 (SPI0 SCLK)",
      "15"
    ],
    [
      "GPIO16 (SPI0 MOSI)",
      "16"
    ],
    [
      "GPIO17 (SPI0 MISO)",
      "17"
    ],
    [
      "GPIO60 (PWM0)",
      "60"
    ],
    [
      "GPIO61 (PWM1)",
      "61"
    ],
    [
      "LED (GPIO52)",
      "52"
    ],
    [
      "KEY (GPIO21)",
      "21"
    ],
    [
      "Fill light (GPIO46 / PWM2)",
      "46"
    ],
    [
      "Buzzer (GPIO47 / PWM3)",
      "47"
    ]
  ],
  "pwmPins": [
    [
      "PWM0 (GPIO60)",
      "60"
    ],
    [
      "PWM1 (GPIO61)",
      "61"
    ],
    [
      "PWM2 / Fill light (GPIO46)",
      "46"
    ],
    [
      "PWM3 / Buzzer (GPIO47)",
      "47"
    ]
  ],
  "serialPort": [
    [
      "UART2",
      "UART2"
    ]
  ],
  "serialPins": {
    "UART2": [
      [
        "TX",
        "11"
      ],
      [
        "RX",
        "12"
      ]
    ]
  },
  "serialSpeed": [
