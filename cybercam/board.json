      "9600",
      "9600"
    ],
    [
      "19200",
      "19200"
    ],
    [
      "38400",
      "38400"
    ],
    [
      "57600",
      "57600"
    ],
    [
      "115200",
      "115200"
    ]
  ],
  "i2c": [
    [
      "I2C2",
      "I2C2"
    ],
    [
      "I2C1 (onboard IMU)",
      "I2C1"
    ]
  ],
  "i2cPins": {
    "I2C2": [
      [
        "SCL",
        "11"
      ],
